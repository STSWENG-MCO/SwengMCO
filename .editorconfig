root = true

[*.{kt,kts}]
# Jetpack Compose functions are PascalCase by convention (and by our team standard),
# and Android instrumented @Test methods use subject_action_result snake_case (D8 rejects
# spaces in method names below API 30), so ktlint's function-naming rule ignores both.
ktlint_function_naming_ignore_when_annotated_with = Composable, Test

# Existing code has many long lines; not enforced for now.
ktlint_standard_max-line-length = disabled

# Comment/style rules the existing code doesn't follow and ktlint can't auto-fix.
ktlint_standard_no-consecutive-comments = disabled
ktlint_standard_filename = disabled
ktlint_standard_if-else-wrapping = disabled
ktlint_standard_comment-wrapping = disabled
